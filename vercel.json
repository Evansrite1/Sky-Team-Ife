{
  "headers": [
    {
      "source": "/js/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp?route=mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?route=prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/mcp?route=prm"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp?route=asm"
    },
    {
      "source": "/register",
      "destination": "/api/mcp?route=register"
    },
    {
      "source": "/authorize",
      "destination": "/api/mcp?route=authorize"
    },
    {
      "source": "/token",
      "destination": "/api/mcp?route=token"
    }
  ],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60
    }
  }
}
